# Generated audio — regenerable from timing.json by voice.mjs in ~46 s, and TTS is
# deterministic (verified across three runs: identical durations every time).
voiceover.mp3
segment_*.mp3
gap_*.mp3
lead.mp3
outro.mp3

# Generated music bed (~96 MB) and the envelope it ducks against. Both rebuild in ~16 s.
music.wav
bed.wav
vo-envelope.json

# Retry log — only written when a synthesis attempt fails.
heal-log.txt

# Frame capture and encode output. 7,519 PNGs plus two MP4s is ~2 GB.
frames/
*.mp4

# Generated by the pipeline, rebuilt every run.
#   video-auto.html  — S5 scene build (write-build-html.mjs), ~140 KB
#   encoder/         — copies encode-mp4.mjs makes of encoder-page.html + mp4-muxer.js
video-auto.html
encoder/
.capture-meta.json
frames.lock

# Machine-local absolute path to the ffmpeg binary. Required for S8/S9; not portable.
ffmpeg-path.txt

# Kept deliberately, do NOT add here:
#   calibration-observed.json  — the measured word rate; continuity data for the next video
#   silence-observed.json      — decoded pacing evidence (bug-ledger entry 13)
#   sync-mapping.md            — the S3/S4 receipt
#   timing.json                — the timeline itself, including measured word boundaries
#   qc/                        — QC frames and the measured per-stage cost log
#   evidence-pack/.gitkeep     — write-build-html resolves the directory unconditionally
